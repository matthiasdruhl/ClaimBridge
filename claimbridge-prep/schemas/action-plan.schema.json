{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claimbridge.example/schemas/action-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "claim_id": {
      "type": "string"
    },
    "claim_revision": {
      "type": "integer"
    },
    "status": {
      "enum": [
        "draft",
        "needs_information",
        "ready_for_review"
      ]
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "owner": {
            "enum": [
              "member",
              "provider",
              "plan",
              "reviewer"
            ]
          },
          "title": {
            "type": "string"
          },
          "instructions": {
            "type": "string"
          },
          "status": {
            "enum": [
              "suggested",
              "draft",
              "user_confirmed_done",
              "blocked"
            ]
          },
          "due": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "value": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "status": {
                "enum": [
                  "explicit",
                  "user_reported",
                  "derived",
                  "unknown",
                  "conflicted"
                ]
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "reason": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "derivation": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "method": {
                        "type": "string"
                      },
                      "input_fact_paths": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "required": [
                      "method",
                      "input_fact_paths"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "value",
              "status",
              "evidence_ids",
              "reason",
              "derivation"
            ]
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "completion_evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "owner",
          "title",
          "instructions",
          "status",
          "due",
          "depends_on",
          "evidence_ids",
          "completion_evidence_ids"
        ]
      }
    },
    "arguments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requested_remedy": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "statement",
          "evidence_ids",
          "limitations",
          "requested_remedy"
        ]
      }
    },
    "submitted": {
      "const": false
    }
  },
  "required": [
    "claim_id",
    "claim_revision",
    "status",
    "actions",
    "arguments",
    "submitted"
  ]
}
