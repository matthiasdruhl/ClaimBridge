# Backend-only variables. Never put secrets in a VITE_* variable.
# This scaffold does not read .env automatically. Export values in your shell.
CLAIMBRIDGE_DATA_DIR=./var
# Choose an LLM provider and its credential name during integration.

# Export these in the backend shell; .env is not automatically loaded.
CLAIMBRIDGE_API_KEY=
CLAIMBRIDGE_API_BASE_URL=
CLAIMBRIDGE_MODEL=
# Base URL must be HTTPS and include the provider API version path (such as /v1).
# No model is assumed; choose one enabled in your provider account.
