# Backend-only configuration. Never use VITE_* variables for secrets.
# Paste your Meta API key between the quotes below.
CLAIMBRIDGE_API_KEY=''
CLAIMBRIDGE_API_BASE_URL='https://api.meta.ai/v1'
# Confirm this model is enabled in your Meta account.
CLAIMBRIDGE_MODEL='muse-spark-1.3'
CLAIMBRIDGE_DATA_DIR='./var'

# Run make dev to load this file and start both services.
# Existing shell environment values take precedence. Ctrl+C stops both.
# Standalone API/evaluation commands still need exported variables.
